{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>imbo-fr/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Do not pin the project's own image to a digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/imbo-fr/huawei-lte-exporter"],
      "pinDigests": false
    }
  ]
}
